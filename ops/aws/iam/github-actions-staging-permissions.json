{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "PushAndInspectStagingImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:DescribeImages",
        "ecr:DescribeImageScanFindings",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:908027418886:repository/dear-diary-sync-api"
    },
    {
      "Sid": "DeployTheStagingLambda",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionConcurrency",
        "lambda:GetFunctionUrlConfig",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:UpdateFunctionUrlConfig"
      ],
      "Resource": "arn:aws:lambda:ap-south-1:908027418886:function:dear-diary-sync-staging"
    },
    {
      "Sid": "ReadStagingParametersForLambda",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:ap-south-1:908027418886:parameter/dear-diary/staging/*"
    },
    {
      "Sid": "RunAndInspectAmplifyStagingJobs",
      "Effect": "Allow",
      "Action": ["amplify:GetBranch", "amplify:GetJob", "amplify:StartJob"],
      "Resource": [
        "arn:aws:amplify:ap-south-1:908027418886:apps/d33b4rjnv35mrn/branches/staging",
        "arn:aws:amplify:ap-south-1:908027418886:apps/d33b4rjnv35mrn/branches/staging/jobs/*"
      ]
    }
  ]
}
