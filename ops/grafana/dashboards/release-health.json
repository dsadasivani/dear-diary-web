{
  "title": "Loredays Release Health",
  "uid": "deardiary-release",
  "schemaVersion": 39,
  "version": 2,
  "tags": ["loredays", "observability", "release"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "^grafanacloud-boldmint1469-prom$",
        "current": {
          "text": "grafanacloud-boldmint1469-prom",
          "value": "grafanacloud-prom"
        }
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "^grafanacloud-boldmint1469-logs$",
        "current": {
          "text": "grafanacloud-boldmint1469-logs",
          "value": "grafanacloud-logs"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "staging,production",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": false,
        "current": { "text": "staging", "value": "staging" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend telemetry age",
      "description": "Seconds since the latest backend metric sample. Yellow after 60 seconds; red after 5 minutes.",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - max(timestamp(sync_database_pool_active{environment=~\"${environment:regex}\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Frontend telemetry records",
      "description": "Privacy-safe Faro measurements received during the selected time range.",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(count_over_time({kind=~\"measurement|measurements\"} | json | app_name=\"dear-diary-client\" | app_environment=~\"${environment:regex}\" [$__range])) or on() vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Frontend exceptions",
      "description": "Faro exceptions received during the selected time range. Any increase should be checked by release.",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({kind=~\"exception|exceptions\"} | json | app_name=\"dear-diary-client\" | app_environment=~\"${environment:regex}\" [$__range])) or on() vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Client push outcomes",
      "description": "Successful and failed synchronization pushes from Faro measurements.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (type) (sum_over_time({kind=~\"measurement|measurements\"} | json | app_name=\"dear-diary-client\" | app_environment=~\"${environment:regex}\" | type=~\"deardiary\\\\.sync\\\\.push\\\\.(success|failure)\" | unwrap value_value | __error__=\"\" [$__auto]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Client pull outcomes",
      "description": "Successful and failed synchronization pulls from Faro measurements.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (type) (sum_over_time({kind=~\"measurement|measurements\"} | json | app_name=\"dear-diary-client\" | app_environment=~\"${environment:regex}\" | type=~\"deardiary\\\\.sync\\\\.pull\\\\.(success|failure)\" | unwrap value_value | __error__=\"\" [$__auto]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Frontend signals by release",
      "description": "Measurement rate grouped by the Faro application version embedded at build time.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "eps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (app_version) (rate({kind=~\"measurement|measurements\"} | json | app_name=\"dear-diary-client\" | app_environment=~\"${environment:regex}\" [$__auto]))",
          "legendFormat": "{{app_version}}",
          "refId": "A"
        }
      ]
    }
  ]
}
