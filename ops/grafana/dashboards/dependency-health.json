{
  "title": "Loredays Dependency Health",
  "uid": "deardiary-dependencies",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [{ "name": "metrics", "label": "Metrics", "type": "datasource", "query": "prometheus" }]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Object storage latency p95",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sync_object_storage_request_duration_seconds_bucket[10m])))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Database pool active",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [{ "expr": "hikaricp_connections_active" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database pool pending",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [{ "expr": "hikaricp_connections_pending" }]
    }
  ]
}
