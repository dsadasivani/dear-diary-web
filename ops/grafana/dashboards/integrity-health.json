{
  "title": "Dear Diary Integrity Health",
  "uid": "deardiary-integrity",
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [{ "name": "metrics", "label": "Metrics", "type": "datasource", "query": "prometheus" }]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Hash mismatches",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [{ "expr": "sum(increase(deardiary_sync_integrity_hash_mismatch_total[24h]))" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Invariant failures",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [
        { "expr": "sum(increase(deardiary_sync_integrity_invariant_failure_total[24h]))" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Missing objects",
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "targets": [
        {
          "expr": "sum(increase(sync_object_validation_failure_total{error_code=\"OBJECT_MISSING\"}[24h]))"
        }
      ]
    }
  ]
}
