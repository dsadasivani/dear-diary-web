{
  "title": "Loredays Observability Overview",
  "uid": "deardiary-observability",
  "schemaVersion": 39,
  "version": 2,
  "tags": ["loredays", "observability", "overview"],
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "^grafanacloud-boldmint1469-prom$",
        "current": {
          "text": "grafanacloud-boldmint1469-prom",
          "value": "grafanacloud-prom"
        }
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "^grafanacloud-boldmint1469-logs$",
        "current": {
          "text": "grafanacloud-boldmint1469-logs",
          "value": "grafanacloud-logs"
        }
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "^grafanacloud-boldmint1469-traces$",
        "current": {
          "text": "grafanacloud-boldmint1469-traces",
          "value": "grafanacloud-traces"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "custom",
        "query": "staging,production",
        "includeAll": true,
        "allValue": ".*",
        "allowCustomValue": false,
        "current": { "text": "staging", "value": "staging" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Backend telemetry age",
      "description": "Seconds since the latest backend metric sample. Yellow after 60 seconds; red after 5 minutes.",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${metrics}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 60 },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "time() - max(timestamp(sync_database_pool_active{environment=~\"${environment:regex}\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP requests / second",
      "description": "Log-derived inbound request rate grouped by route and status; remains available when HTTP server metrics are not exported.",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 0 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "topk(15, sum by (httpStatus, httpRoute) (rate({service_name=\"dear-diary-sync-api\", deployment_environment=~\"${environment:regex}\"} |= \"HTTP request completed\" | httpRoute != \"/actuator/health\" [$__auto])))",
          "legendFormat": "{{httpStatus}} {{httpRoute}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP latency p95 (logs)",
      "description": "Log-derived 95th-percentile request duration, aggregated across streams.",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 0 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        {
          "expr": "max(quantile_over_time(0.95, {service_name=\"dear-diary-sync-api\", deployment_environment=~\"${environment:regex}\"} |= \"HTTP request completed\" | httpRoute != \"/actuator/health\" | unwrap durationMs | __error__=\"\" [$__auto]))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Sync API logs",
      "description": "Structured backend logs. Expand a row for correlation, trace, span, HTTP, and release fields.",
      "gridPos": { "h": 12, "w": 14, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "${logs}" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "targets": [
        {
          "expr": "{service_name=\"dear-diary-sync-api\", deployment_environment=~\"${environment:regex}\"}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "traces",
      "title": "Recent sync API traces",
      "description": "Sampled server traces for the selected environment.",
      "gridPos": { "h": 12, "w": 10, "x": 14, "y": 8 },
      "datasource": { "type": "tempo", "uid": "${traces}" },
      "targets": [
        {
          "query": "{ resource.service.name = \"dear-diary-sync-api\" && resource.deployment.environment =~ \"${environment:regex}\" }",
          "queryType": "traceql",
          "refId": "A",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
